GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Logging
LOG_LEVEL=INFO         # DEBUG | INFO | WARNING | ERROR
DEBUG=False            # Set True to enable verbose AgentExecutor chain logging

# Model selection (Groq GPT-OSS models)
GROQ_AGENT_MODEL=openai/gpt-oss-120b
GROQ_COMPRESSION_MODEL=openai/gpt-oss-20b

# Agent tuning
AGENT_MAX_ITERATIONS=4  # Max ReAct loop iterations (lower = faster tail latency)